<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:colorAccent">#E53935</item>
    </style>

    <!-- 看视频的主界面：不要系统标题栏，自己的顶栏够用 -->
    <style name="AppTheme.NoTitle">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- 悬浮窗标题行右边的小按钮 -->
    <style name="CardAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">7dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?android:attr/colorAccent</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
